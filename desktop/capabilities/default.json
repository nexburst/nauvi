{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Capabilities for the kubeloupe desktop app",
  "windows": ["main", "cluster-*"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://127.0.0.1:*" },
        { "url": "http://localhost:*" },
        { "url": "https://github.com/pedrosanzmtz/kubeloupe/releases" },
        { "url": "https://github.com/pedrosanzmtz/kubeloupe/releases/*" }
      ],
      "deny": [{ "url": "*@*" }]
    }
  ]
}
