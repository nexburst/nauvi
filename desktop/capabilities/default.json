{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Capabilities for the kubeloupe desktop app",
  "windows": ["main", "cluster-*"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ],
      "deny": [{ "url": "*@*" }]
    }
  ]
}
