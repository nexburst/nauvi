{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nauvi",
  "version": "0.4.1",
  "identifier": "com.nauvi.app",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "ui-src" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "ui-src" },
    "frontendDist": "ui-src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "nauvi",
        "width": 1280,
        "height": 800,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A Lens alternative written in Rust - a Kubernetes IDE",
    "publisher": "nauvi",
    "copyright": "Copyright (c) 2026 the nauvi contributors",
    "license": "MIT",
    "licenseFile": "bundle/license.txt",
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "desktopTemplate": "bundle/nauvi.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["nauvi"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4QjhBMUJDN0ZCOUFBNEQKUldSTnFybC92S0c0NkdPWTIyc29yQ0REeEZJTlB2Qi9iK09uYmQ4OU1JODdwY1QrV3NOcGliNksK",
      "endpoints": ["https://github.com/nexburst/nauvi/releases/latest/download/latest.json"]
    }
  }
}
