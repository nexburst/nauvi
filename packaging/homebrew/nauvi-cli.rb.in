# Generated by scripts/release/homebrew.sh from packaging/homebrew/nauvi-cli.rb.in
# in nexburst/nauvi. Edit the template there, not this file.
class NauviCli < Formula
  desc "Kubernetes CLI for resources, logs, exec and port-forwarding"
  homepage "https://github.com/nexburst/nauvi"
  license "MIT"

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_arm do
      url "https://github.com/nexburst/nauvi/releases/download/v@VERSION@/nauvi-cli-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@CLI_AARCH64_APPLE_DARWIN_SHA256@"
    end
    on_intel do
      url "https://github.com/nexburst/nauvi/releases/download/v@VERSION@/nauvi-cli-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@CLI_X86_64_APPLE_DARWIN_SHA256@"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/nexburst/nauvi/releases/download/v@VERSION@/nauvi-cli-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@CLI_X86_64_UNKNOWN_LINUX_GNU_SHA256@"
    end
  end

  def install
    bin.install "nauvi"
    generate_completions_from_executable(bin/"nauvi", "completions")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/nauvi --version")
    assert_match "complete", shell_output("#{bin}/nauvi completions bash")
  end
end
